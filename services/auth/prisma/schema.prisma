generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum SessionAudience {
  MARKETPLACE
}

enum AuthLoginAttemptState {
  ADMITTED
  COMMITTED
  CANCELLED
  REJECTED
  EXPIRED
}

enum AuthAdmissionReservationState {
  RESERVED
  CONSUMED
  CANCELLED
  EXPIRED
}

model Account {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @db.VarChar(254)
  emailNormalized    String                   @unique @db.VarChar(254)
  passwordHash       String                   @db.Text
  credentialVersion  Int                      @default(1)
  status             AccountStatus            @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?                @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  verificationTokens EmailVerificationToken[]
  sessions           AuthSession[]
}

model EmailVerificationToken {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @db.Uuid
  emailNormalized String    @db.VarChar(254)
  tokenHash       String    @unique @db.Char(64)
  expiresAt       DateTime  @db.Timestamptz(3)
  consumedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model ServiceAssertionReplay {
  issuer     String   @db.VarChar(255)
  jti        String   @db.VarChar(32)
  expiresAt  DateTime @db.Timestamptz(3)
  consumedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([issuer, jti])
  @@index([expiresAt])
}

model AuthAdmissionControl {
  id                String   @id @db.VarChar(32)
  epoch             String   @db.Uuid
  enabled           Boolean  @default(false)
  activeHour        BigInt
  closedThroughHour BigInt
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

model AuthAdmissionNamespace {
  id       String    @id @default(uuid()) @db.Uuid
  epoch    String    @db.Uuid
  hour     BigInt
  openedAt DateTime  @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)

  reservations AuthAdmissionReservation[]

  @@unique([epoch, hour])
}

model AuthAdmissionReservation {
  id                     String                        @id @default(uuid()) @db.Uuid
  namespaceId            String                        @db.Uuid
  attemptComponent       String                        @db.Uuid
  callerIssuer           String                        @db.VarChar(255)
  audience               SessionAudience
  operation              String                        @db.VarChar(128)
  contextBinding         String                        @db.VarChar(255)
  authorizationHash      String                        @unique @db.Char(64)
  state                  AuthAdmissionReservationState @default(RESERVED)
  createdAt              DateTime                      @db.Timestamptz(3)
  authorizationExpiresAt DateTime                      @db.Timestamptz(3)
  issuanceExpiresAt      DateTime                      @db.Timestamptz(3)
  recoveryExpiresAt      DateTime                      @db.Timestamptz(3)
  consumedAt             DateTime?                     @db.Timestamptz(3)
  cancelledAt            DateTime?                     @db.Timestamptz(3)
  reconciliationPending  Boolean                       @default(false)

  namespace AuthAdmissionNamespace @relation(fields: [namespaceId], references: [id], onDelete: Restrict)
  attempt   AuthLoginAttempt?

  @@unique([namespaceId, attemptComponent])
  @@index([callerIssuer, createdAt])
  @@index([callerIssuer, audience, contextBinding, createdAt])
  @@index([state, issuanceExpiresAt])
  @@index([recoveryExpiresAt])
}

model AuthAdmissionCallerQuota {
  callerIssuer String   @id @db.VarChar(255)
  tokens       Float
  refilledAt   DateTime @db.Timestamptz(3)
}

model AuthLoginAttempt {
  id                    String                @id @default(uuid()) @db.Uuid
  reservationId         String?               @unique @db.Uuid
  callerIssuer          String                @db.VarChar(255)
  audience              SessionAudience
  contextBinding        String                @db.VarChar(255)
  state                 AuthLoginAttemptState @default(ADMITTED)
  admittedAt            DateTime              @default(now()) @db.Timestamptz(3)
  issuanceExpiresAt     DateTime              @db.Timestamptz(3)
  recoveryExpiresAt     DateTime              @db.Timestamptz(3)
  cancelledAt           DateTime?             @db.Timestamptz(3)
  verificationClaimHash String?               @db.Char(64)
  verificationClaimedAt DateTime?             @db.Timestamptz(3)
  verificationStartedAt DateTime?             @db.Timestamptz(3)

  reservation AuthAdmissionReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  session     AuthSession?

  @@index([callerIssuer, audience])
  @@index([recoveryExpiresAt])
}

model AuthSession {
  id              String          @id @default(uuid()) @db.Uuid
  accountId       String          @db.Uuid
  audience        SessionAudience
  loginAttemptId  String?         @unique @db.Uuid
  authenticatedAt DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime        @db.Timestamptz(3)
  revokedAt       DateTime?       @db.Timestamptz(3)

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  loginAttempt AuthLoginAttempt? @relation(fields: [loginAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId, audience])
  @@index([expiresAt])
}
