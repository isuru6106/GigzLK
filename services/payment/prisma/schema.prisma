generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  LKR
}

model Payment {
  id              String           @id @default(uuid()) @db.Uuid
  assignmentId    String           @unique @db.Uuid
  grossMinor      BigInt
  currency        Currency         @default(LKR)
  fundedAt        DateTime?        @db.Timestamptz(3)
  approvedAt      DateTime?        @db.Timestamptz(3)
  holdActive      Boolean          @default(false)
  releasedAt      DateTime?        @db.Timestamptz(3)
  version         Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  releaseJournal  ReleaseJournal?
  simulatedPayout SimulatedPayout?
}

enum AccountingSide {
  DEBIT
  CREDIT
}

enum LedgerAccount {
  PROTECTED_FUNDS
  WORKER_PAYABLE
  COMMISSION_REVENUE
}

model ReleaseJournal {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @unique @db.Uuid
  callerId        String   @db.VarChar(100)
  idempotencyKey  String   @db.VarChar(128)
  grossMinor      BigInt
  commissionMinor BigInt
  netMinor        BigInt
  currency        Currency @default(LKR)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  entries         LedgerEntry[]
  simulatedPayout SimulatedPayout?

  @@unique([callerId, idempotencyKey])
}

model LedgerEntry {
  id          String         @id @default(uuid()) @db.Uuid
  journalId   String         @db.Uuid
  position    Int
  account     LedgerAccount
  side        AccountingSide
  amountMinor BigInt
  currency    Currency       @default(LKR)

  journal ReleaseJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@unique([journalId, position])
}

model OutboxEvent {
  eventId          String    @id @default(uuid()) @db.Uuid
  eventType        String    @db.VarChar(100)
  schemaVersion    Int       @default(1)
  producer         String    @db.VarChar(100)
  aggregateId      String    @db.Uuid
  aggregateVersion Int
  occurredAt       DateTime  @db.Timestamptz(3)
  correlationId    String    @db.Uuid
  causationId      String?   @db.Uuid
  data             Json
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime? @db.Timestamptz(3)
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @db.Timestamptz(3)
  claimId          String?   @db.Uuid
  claimExpiresAt   DateTime? @db.Timestamptz(3)
  failedAt         DateTime? @db.Timestamptz(3)

  @@unique([aggregateId, aggregateVersion, eventType])
  @@index([publishedAt, nextAttemptAt, createdAt])
}

model PaymentApprovalRequest {
  id             String   @id @default(uuid()) @db.Uuid
  callerId       String   @db.Uuid
  idempotencyKey String   @db.VarChar(128)
  paymentId      String   @db.Uuid
  response       Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([callerId, idempotencyKey])
  @@index([paymentId])
}

enum SimulatedPayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model SimulatedPayout {
  id               String                @id @default(uuid()) @db.Uuid
  paymentId        String                @unique @db.Uuid
  releaseJournalId String                @unique @db.Uuid
  netMinor         BigInt
  currency         Currency              @default(LKR)
  status           SimulatedPayoutStatus @default(PENDING)
  version          Int                   @default(0)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  completedAt      DateTime?             @db.Timestamptz(3)
  payment          Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  releaseJournal   ReleaseJournal        @relation(fields: [releaseJournalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model SimulatedPayoutRequest {
  id             String                @id @default(uuid()) @db.Uuid
  callerId       String                @db.VarChar(100)
  idempotencyKey String                @db.VarChar(128)
  paymentId      String                @db.Uuid
  outcome        SimulatedPayoutStatus
  response       Json
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([callerId, idempotencyKey])
  @@index([paymentId])
}
